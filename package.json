{
  "name": "bae-job",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Thu thập tin tuyển dụng đa nguồn, đảm bảo còn hiệu lực, thống kê theo ngành nghề người dùng tự định nghĩa",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "crawl": "tsx scripts/crawl.ts",
    "reparse": "tsx scripts/reparse.ts",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "probe": "tsx scripts/probe.ts",
    "db:inspect": "tsx scripts/inspect.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "cheerio": "^1.0.0",
    "next": "^15.5.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "robots-parser": "^3.0.1",
    "server-only": "^0.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "prisma": "^6.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "optionalDependencies": {
