# ─── CSDL ────────────────────────────────────────────────────────────────────
# Neon: dùng chuỗi POOLED (có "-pooler" trong host). Xem TECHSTACK.md §5.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ─── Khoá sửa của giao diện web ───────────────────────────────────────────────
# Mật khẩu để lưu tin và sửa từ điển ngành từ trình duyệt. Để trống thì máy dev
# vẫn ghi được, còn bản production chỉ đọc. Dùng chuỗi ngẫu nhiên dài.
# Xem docs/deploy.md §1.
EDIT_KEY=""

# ─── Danh tính crawler ───────────────────────────────────────────────────────
# BẮT BUỘC điền email thật. User-Agent phải định danh được và liên hệ được —
# đây là điều kiện để việc thu thập là lịch sự chứ không phải lén lút.
CRAWLER_CONTACT_EMAIL="you@example.com"
CRAWLER_BOT_NAME="BaeJobBot"

# ─── Lưu trữ blob thô (TECHSTACK.md §5) ──────────────────────────────────────
# BLOB_DRIVER: "fs" (mặc định, ghi ra .blobs/ ở local) | "r2"
# Trang chi tiết đo được tới 828 KB còn Neon Free chỉ 0,5 GB, nên HTML thô
# KHÔNG BAO GIỜ được nằm trong Postgres. Xem TECHSTACK.md §5.
BLOB_DRIVER="fs"
BLOB_FS_DIR=".blobs"

# Chỉ cần khi BLOB_DRIVER="r2"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="bae-job-raw"

# ─── Tỷ giá quy đổi lương ────────────────────────────────────────────────────
# Lương USD được quy về VND để thống kê. Tỷ giá và NGÀY áp dụng đều được lưu
# kèm vào từng bản ghi, nên đổi số này không làm sai lệch dữ liệu cũ.
USD_VND_RATE="25400"
USD_VND_RATE_DATE="2026-08-25"

# ─── Hạn mức lịch sự (để trống là dùng mặc định trong src/constants/crawl) ────
# CRAWL_MIN_DELAY_MS="2000"
# CRAWL_MAX_PAGES_PER_SOURCE="50"
